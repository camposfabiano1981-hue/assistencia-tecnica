rules_version = '2';

// Regras de segurança do Firestore.
// Sem servidor, estas regras são a única barreira: todo acesso passa por aqui.
// Níveis de acesso (coleção usuarios, campo papel):
//   gestor         tudo, inclusive configurações, equipe e cópia de segurança (pode haver vários);
//   administrativo atendimento e financeiro, sem configurações nem equipe;
//   tecnico        atendimento técnico, sem o financeiro;
//   cliente        só o portal, com os dados do próprio cadastro.
// Conta sem perfil ativo não acessa nada.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções de apoio ----------
    function logado() { return request.auth != null; }
    function temPerfil() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo() { return temPerfil() && perfil().ativo == true; }
    function gestor() { return ativo() && perfil().papel == 'gestor'; }
    function administrativo() { return ativo() && perfil().papel == 'administrativo'; }
    function tecnico() { return ativo() && perfil().papel == 'tecnico'; }
    function equipe() { return ativo() && perfil().papel in ['gestor', 'administrativo', 'tecnico']; }
    // Orçamentos, faturas, contratos e preços: gestor e administrativo (o técnico não vê).
    function financeiro() { return ativo() && perfil().papel in ['gestor', 'administrativo']; }
    function cliente() { return ativo() && perfil().papel == 'cliente'; }
    function meuCliente() { return perfil().clienteId; }
    function dados() { return request.resource.data; }
    function texto(v, max) { return v is string && v.size() <= max; }
    function instalado() { return exists(/databases/$(database)/documents/config/instalacao); }

    // Primeiro acesso: a pessoa cria o próprio perfil de gestor e trava a instalação no mesmo lote.
    function instalando() {
      return logado() && !instalado()
        && existsAfter(/databases/$(database)/documents/config/instalacao)
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'gestor';
    }

    // ---------- Usuários ----------
    match /usuarios/{uid} {
      function usuarioValido() {
        return dados().papel in ['gestor', 'administrativo', 'tecnico', 'cliente']
          && dados().ativo is bool
          && texto(dados().nome, 120)
          && texto(dados().email, 200)
          && (dados().papel != 'cliente'
              || (dados().clienteId is string
                  && exists(/databases/$(database)/documents/clientes/$(dados().clienteId))));
      }
      allow read: if logado() && (request.auth.uid == uid || equipe());
      // O gestor cadastra qualquer nível (inclusive outros gestores); o administrativo só dá acesso de cliente ao portal.
      allow create: if (gestor() && usuarioValido())
        || (administrativo() && dados().papel == 'cliente' && usuarioValido())
        || (request.auth.uid == uid && instalando()
            && dados().papel == 'gestor' && dados().ativo == true && usuarioValido());
      // Ninguém rebaixa nem bloqueia a si mesmo: assim sempre sobra ao menos um gestor.
      allow update: if (gestor() && usuarioValido()
          && (uid != request.auth.uid || (dados().papel == 'gestor' && dados().ativo == true)))
        || (administrativo() && resource.data.papel == 'cliente' && dados().papel == 'cliente' && usuarioValido());
      allow delete: if false;
    }

    // ---------- Configurações ----------
    match /config/instalacao {
      allow read: if true;
      allow create: if logado() && !instalado()
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'gestor';
      allow update, delete: if false;
    }
    match /config/publico {
      // Só nome e WhatsApp da empresa: usado pela etiqueta QR antes do login.
      allow read: if true;
      allow write: if (gestor() || instalando()) && dados().keys().hasOnly(['nome', 'whatsapp']);
    }
    match /config/empresa {
      allow read: if ativo();
      allow write: if gestor() || instalando();
    }

    // ---------- Cadastros ----------
    match /clientes/{id} {
      allow read: if equipe() || (cliente() && meuCliente() == id);
      allow create, update: if equipe() && texto(dados().nome, 200) && dados().ativo is bool;
      allow delete: if gestor();
    }

    match /tiposEquipamento/{id} {
      allow read: if ativo();
      allow write: if gestor();
    }

    match /equipamentos/{id} {
      allow read: if equipe() || (cliente() && resource.data.clienteId == meuCliente());
      allow create, update: if equipe()
        && dados().clienteId is string
        && exists(/databases/$(database)/documents/clientes/$(dados().clienteId))
        && texto(dados().tipoNome, 120);
      allow delete: if gestor();
    }

    // ---------- Numeração sequencial ----------
    // O contador só sobe de 1 em 1 e só junto com a criação do documento de mesmo número.
    match /contadores/chamados {
      allow read: if ativo();
      allow create: if ativo() && dados().keys().hasOnly(['n']) && dados().n == 1
        && existsAfter(/databases/$(database)/documents/chamados/1);
      allow update: if ativo() && dados().keys().hasOnly(['n']) && dados().n == resource.data.n + 1
        && existsAfter(/databases/$(database)/documents/chamados/$(string(dados().n)));
    }
    match /contadores/os {
      allow read: if equipe();
      allow create: if equipe() && dados().keys().hasOnly(['n']) && dados().n == 1
        && existsAfter(/databases/$(database)/documents/os/1);
      allow update: if equipe() && dados().keys().hasOnly(['n']) && dados().n == resource.data.n + 1
        && existsAfter(/databases/$(database)/documents/os/$(string(dados().n)));
    }

    // ---------- Chamados ----------
    match /chamados/{id} {
      function contadorOk() {
        return getAfter(/databases/$(database)/documents/contadores/chamados).data.n == int(id)
          && dados().numero == int(id);
      }
      function camposValidos() {
        return texto(dados().relato, 4000) && dados().relato.size() > 0
          && dados().parado is bool
          && dados().qtdFotos is int && dados().qtdFotos >= 0 && dados().qtdFotos <= 3
          && texto(dados().equipamentoDescricao, 300)
          && dados().historico is list;
      }
      function equipamentoDoCliente() {
        return dados().equipamentoId == null
          || get(/databases/$(database)/documents/equipamentos/$(dados().equipamentoId)).data.clienteId == meuCliente();
      }
      allow read: if equipe() || (cliente() && resource.data.clienteId == meuCliente());
      allow create: if contadorOk() && camposValidos() && (
        equipe()
        || (cliente()
            && dados().keys().hasOnly(['numero', 'clienteId', 'clienteNome', 'equipamentoId',
                 'equipamentoDescricao', 'relato', 'parado', 'status', 'origem', 'abertoPor',
                 'abertoEm', 'atualizadoEm', 'qtdFotos', 'contato', 'historico'])
            && dados().clienteId == meuCliente()
            && dados().clienteNome == get(/databases/$(database)/documents/clientes/$(meuCliente())).data.nome
            && dados().status == 'aberto'
            && dados().origem == 'portal'
            && dados().abertoPor.uid == request.auth.uid
            && dados().abertoEm == request.time
            && dados().historico.size() == 1
            && equipamentoDoCliente())
      );
      allow update: if equipe()
        && dados().numero == resource.data.numero
        && dados().clienteId == resource.data.clienteId;
      allow delete: if false;

      // Fotos enviadas no chamado: no máximo 3 (ids f1, f2, f3), até ~400 KB cada.
      match /fotos/{fotoId} {
        function chamado() { return get(/databases/$(database)/documents/chamados/$(id)).data; }
        allow read: if equipe() || (cliente() && chamado().clienteId == meuCliente());
        allow create: if fotoId in ['f1', 'f2', 'f3']
          && (equipe() || (cliente() && chamado().clienteId == meuCliente()
                           && chamado().abertoPor.uid == request.auth.uid))
          && dados().imagem is bytes && dados().imagem.size() <= 400000
          && dados().clienteId == chamado().clienteId;
        allow delete: if equipe();
      }
    }

    // ---------- Ordens de serviço ----------
    match /os/{id} {
      function contadorOk() {
        return getAfter(/databases/$(database)/documents/contadores/os).data.n == int(id)
          && dados().numero == int(id);
      }
      // Gestor e administrativo editam qualquer OS (agenda, troca de técnico); o técnico, só as dele.
      function podeEditar() {
        return gestor() || administrativo() || (tecnico() && resource.data.tecnicoId == request.auth.uid);
      }
      allow read: if equipe()
        || (cliente() && resource.data.clienteId == meuCliente() && resource.data.status == 'concluida');
      allow create: if equipe() && contadorOk() && dados().status == 'aberta'
        && dados().clienteId is string && dados().tecnicoId is string;
      // OS concluída (assinada) fica somente leitura para todos.
      allow update: if podeEditar() && resource.data.status != 'concluida'
        && dados().numero == resource.data.numero
        && dados().clienteId == resource.data.clienteId
        && (dados().status != 'concluida'
            || (dados().assinatura != null && dados().assinatura.imagem is bytes && dados().liberado is bool));
      allow delete: if false;

      match /fotos/{fotoId} {
        function os() { return get(/databases/$(database)/documents/os/$(id)).data; }
        allow read: if equipe()
          || (cliente() && os().clienteId == meuCliente() && os().status == 'concluida');
        allow create: if equipe() && os().status != 'concluida'
          && dados().imagem is bytes && dados().imagem.size() <= 400000;
        allow delete: if equipe() && os().status != 'concluida';
      }
    }

    // ================= Fase 2 =================

    // Numeração de orçamentos e faturas (mesma trava dos chamados e OS). Financeiro: gestor e administrativo.
    match /contadores/orcamentos {
      allow read: if financeiro();
      allow create: if financeiro() && dados().keys().hasOnly(['n']) && dados().n == 1
        && existsAfter(/databases/$(database)/documents/orcamentos/1);
      allow update: if financeiro() && dados().keys().hasOnly(['n']) && dados().n == resource.data.n + 1
        && existsAfter(/databases/$(database)/documents/orcamentos/$(string(dados().n)));
    }
    match /contadores/faturas {
      allow read: if financeiro();
      allow create: if financeiro() && dados().keys().hasOnly(['n']) && dados().n == 1
        && existsAfter(/databases/$(database)/documents/faturas/1);
      allow update: if financeiro() && dados().keys().hasOnly(['n']) && dados().n == resource.data.n + 1
        && existsAfter(/databases/$(database)/documents/faturas/$(string(dados().n)));
    }

    // ---------- Orçamentos ----------
    match /orcamentos/{id} {
      function contadorOk() {
        return getAfter(/databases/$(database)/documents/contadores/orcamentos).data.n == int(id)
          && dados().numero == int(id);
      }
      function visivelAoCliente() {
        return resource.data.status in ['enviado', 'aprovado', 'recusado'];
      }
      function dentroDaValidade() {
        return !('validadeAte' in resource.data) || resource.data.validadeAte == null
          || request.time <= resource.data.validadeAte;
      }
      // O cliente só responde: aprova ou recusa um orçamento enviado, dentro da validade,
      // sem alterar nenhum outro campo (valores, itens, condições).
      function respostaDoCliente() {
        return resource.data.status == 'enviado'
          && dados().status in ['aprovado', 'recusado']
          && dados().diff(resource.data).affectedKeys().hasOnly(['status', 'resposta', 'atualizadoEm'])
          && dados().resposta.status == dados().status
          && dados().resposta.uid == request.auth.uid
          && dados().resposta.em == request.time
          && texto(dados().resposta.nome, 120)
          && (!('motivo' in dados().resposta) || texto(dados().resposta.motivo, 500))
          && dentroDaValidade();
      }
      allow read: if financeiro()
        || (cliente() && resource.data.clienteId == meuCliente() && visivelAoCliente());
      allow create: if financeiro() && contadorOk() && dados().clienteId is string && dados().total is number;
      allow update: if (financeiro() && dados().numero == resource.data.numero && dados().clienteId == resource.data.clienteId)
        || (cliente() && resource.data.clienteId == meuCliente() && respostaDoCliente());
      allow delete: if false;
    }

    // ---------- Faturas ----------
    match /faturas/{id} {
      function contadorOk() {
        return getAfter(/databases/$(database)/documents/contadores/faturas).data.n == int(id)
          && dados().numero == int(id);
      }
      allow read: if financeiro() || (cliente() && resource.data.clienteId == meuCliente());
      allow create: if financeiro() && contadorOk() && dados().clienteId is string && dados().total is number;
      allow update: if financeiro() && dados().numero == resource.data.numero && dados().clienteId == resource.data.clienteId;
      allow delete: if false;
    }

    // ---------- Instrumentos e estoque: só a equipe ----------
    match /instrumentos/{id} {
      allow read, create, update: if equipe();
      allow delete: if gestor();
    }
    match /pecas/{id} {
      allow read: if equipe();
      // Cadastro e preços: gestor e administrativo. O técnico só mexe no saldo (baixa da OS, entrada, ajuste).
      allow create: if financeiro();
      allow update: if financeiro()
        || (tecnico() && dados().diff(resource.data).affectedKeys().hasOnly(['quantidade']));
      allow delete: if gestor();
      // Histórico de movimentos não se altera nem se apaga.
      match /movimentos/{movimento} {
        allow read, create: if equipe();
        allow update, delete: if false;
      }
    }

    // ================= Fase 3 =================

    // ---------- Autenticidade dos laudos ----------
    // Qualquer pessoa confere um laudo pelo código impresso nele; listar os códigos, só o gestor.
    // O registro nasce junto com a conclusão da OS (mesmo lote) e não muda depois.
    match /verificacoes/{codigo} {
      allow get: if true;
      // Só o gestor lista (cópia de segurança); o público confere um código por vez.
      allow list: if gestor();
      allow create: if equipe() && codigo.size() == 16
        && dados().osId is string
        && getAfter(/databases/$(database)/documents/os/$(dados().osId)).data.codigoVerificacao == codigo;
      allow update, delete: if false;
    }

    // ---------- Avaliação do atendimento: uma por OS concluída, feita pelo próprio cliente ----------
    match /avaliacoes/{osId} {
      function osAvaliada() { return get(/databases/$(database)/documents/os/$(osId)).data; }
      // resource == null: o cliente pode perguntar se a OS já foi avaliada.
      allow get: if equipe() || (cliente() && (resource == null || resource.data.clienteId == meuCliente()));
      allow list: if equipe() || (cliente() && resource.data.clienteId == meuCliente());
      allow create: if cliente()
        && osAvaliada().clienteId == meuCliente() && osAvaliada().status == 'concluida'
        && dados().osId == osId && dados().clienteId == meuCliente()
        && dados().nota is int && dados().nota >= 1 && dados().nota <= 5
        && (!('comentario' in dados()) || texto(dados().comentario, 1000))
        && dados().por.uid == request.auth.uid && dados().em == request.time;
      allow update, delete: if false;
    }

    // ---------- Contratos de manutenção ----------
    match /contadores/contratos {
      allow read: if financeiro();
      allow create: if financeiro() && dados().keys().hasOnly(['n']) && dados().n == 1
        && existsAfter(/databases/$(database)/documents/contratos/1);
      allow update: if financeiro() && dados().keys().hasOnly(['n']) && dados().n == resource.data.n + 1
        && existsAfter(/databases/$(database)/documents/contratos/$(string(dados().n)));
    }
    match /contratos/{id} {
      function contadorOk() {
        return getAfter(/databases/$(database)/documents/contadores/contratos).data.n == int(id)
          && dados().numero == int(id);
      }
      allow read: if financeiro() || (cliente() && resource.data.clienteId == meuCliente());
      allow create: if financeiro() && contadorOk() && dados().clienteId is string && dados().valor is number
        && dados().valor >= 0 && dados().status == 'ativo';
      allow update: if financeiro() && dados().numero == resource.data.numero && dados().clienteId == resource.data.clienteId
        && dados().valor is number && dados().valor >= 0;
      allow delete: if false;
    }

    // ---------- Catálogo de serviços (tabela de preços): a equipe consulta; gestor e administrativo alteram ----------
    match /servicos/{id} {
      allow read: if equipe();
      allow create, update: if financeiro() && texto(dados().descricao, 200) && dados().preco is number && dados().ativo is bool;
      allow delete: if gestor();
    }
  }
}
