{
  "name": "assistencia-tecnica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-assistencia",
    "test:regras": "firebase emulators:exec --only firestore --project demo-assistencia \"vitest run tests/regras.test.ts\"",
    "icones": "NODE_PATH=$(npm root -g) node scripts/gerar-icones.cjs",
    "test:unidade": "vitest run tests/pix.test.ts tests/csv.test.ts tests/datas.test.ts tests/backup.test.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "signature_pad": "^5.1.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
